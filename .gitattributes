*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
.gitignore text eol=lf
*.json -text
config.json text eol=lf
*.npz binary
*.parquet binary
# Preserve exact frozen bytes across clones, including historical console evidence.
# -text disables EOL conversion, not normal textual diff display.
* -text whitespace=cr-at-eol
