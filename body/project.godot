config_version=5

[application]
config/name="MaleCNS — Brain Gets a Body"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]
window/size/viewport_width=1000
window/size/viewport_height=700
window/size/window_width_override=1000
window/size/window_height_override=700

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.13,0.16,0.19,1)
